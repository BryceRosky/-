digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.28", ranksep="0.42", splines=ortho, dpi=220];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, color="#35556B", penwidth=1.3, margin="0.14,0.09"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#526D82", penwidth=1.2, arrowsize=0.72];

  value [label="研究一：条件价值与评价校准\n区分独立评价、代理奖励和状态价值\n分析评价误差与有限补全误差", fillcolor="#FFF2CC", width=4.5];
  credit [label="研究二：分层信用分配\n估计位置与类别决策的贡献\n分析全掩码代理偏差", fillcolor="#E2F0D9", width=3.4];
  search [label="研究三：轨迹搜索\n依据条件价值分配推理预算\n分析误排序和误剪概率", fillcolor="#DDEBF7", width=3.4];
  distill [label="研究四：粗到细少步生成\n蒸馏候选价值、位置频率和 token 分布\n分析教师误差与学生状态偏移", fillcolor="#FCE4D6", width=4.7];
  eval [label="共同评价\n生成质量 · 理解能力 · 多样性\n端到端延迟 · 显存 · GPU-hours", fillcolor="#F2F2F2", color="#777777", width=4.7];

  value -> credit [label="终局反馈"];
  value -> search [label="状态价值"];
  credit -> distill [label="结构先验"];
  search -> distill [label="候选偏好与教师补全"];
  distill -> eval [label="统一实验比较"];
  {rank=same; credit; search}
}

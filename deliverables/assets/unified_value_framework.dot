digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.28", ranksep="0.42", splines=ortho, dpi=220];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, color="#35556B", penwidth=1.3, margin="0.14,0.09"];
  edge [fontname="Noto Sans CJK SC", fontsize=10.5, color="#526D82", penwidth=1.2, arrowsize=0.72];

  value [label="统一评价对象\n终局效用 R_eval(x,c) · 预算条件价值 Vπ(sₜ,c)\n比较时固定未来策略、剩余预算与共同继续调度", fillcolor="#EAF3F8", width=5.3];
  r3 [label="研究三 A：可校准评价器\n图像证据检验 · 完整冻结目标快照\n输出：代理效用及可靠性界限", fillcolor="#FFF2CC", width=3.25];
  r1 [label="研究一：层次 token 信用\n估计位置与类别的边际贡献\n输出：结构概率、信用权重、改进策略", fillcolor="#E2F0D9", width=3.2];
  r2 [label="研究二：自验证轨迹搜索\n估计部分状态的继续生成价值\n输出：候选、相对价值、保留标签与调度", fillcolor="#DDEBF7", width=3.2];
  r4 [label="研究四：粗到细蒸馏\n蒸馏相对价值、位置日程与 token 分布\n恢复数量学习仅作扩展消融", fillcolor="#FCE4D6", width=4.55];
  guard [label="共用约束与验收\n总计算预算 B_comp · POPE/MMBench 分别非劣\n多样性保持 · 单轨迹端到端时延", fillcolor="#F2F2F2", color="#777777", width=5.3];

  value -> r3 [label="定义校准目标"];
  r3 -> r1 [label="终局反馈"];
  r3 -> r2 [label="状态评价器"];
  r1 -> r4 [label="结构先验与策略"];
  r2 -> r4 [label="无删失记录与教师补全"];
  r4 -> guard [label="质量—计算合取检验"];
  {rank=same; r1; r2}
}
